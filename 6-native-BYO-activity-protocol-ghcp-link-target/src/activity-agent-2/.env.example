# Application Insights ΓÇö for end-to-end tracing
# Auto-injected in hosted containers (recommended).
# Set for local telemetry and trace collection.
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...

# Your Foundry model — the Copilot SDK talks to this over the Responses wire API
# using a Managed-Identity bearer token. Both are auto-injected when deployed as a
# hosted agent; set them here only for local runs (`python main.py`).
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5-mini

# Optional — session ID for persistence/resume across restarts.
# If unset, a random UUID is generated per process.
# FOUNDRY_AGENT_SESSION_ID=

# ── Target-agent abstraction (optional) ─────────────────────────────────────
# Make this helper publish to Teams AS an existing target agent — adopting its
# instructions + model (+ tool intent) with no second agent/session. Pick ONE:
#
#   A) Local file: a target-agent.yaml/.json next to the code is auto-detected,
#      or point at an explicit path here.
# TARGET_AGENT_FILE=target-agent.yaml
#
#   B) Existing Foundry agent: fetched from FOUNDRY_PROJECT_ENDPOINT at startup
#      (needs azure-ai-projects). Use the agent's name/id.
# TARGET_AGENT_ID=my-target-agent
#
# If neither is set, the helper keeps its own built-in persona.

# Logging level
LOG_LEVEL=DEBUG


