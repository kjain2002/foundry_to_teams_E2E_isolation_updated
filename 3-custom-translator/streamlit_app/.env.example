# ─────────────────────────────────────────────────────────────────────
# Foundry → Teams Publisher (Streamlit) — environment variables
# Copy this file to .env and fill in values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────

# === Auth mode ===
# sso   = production: Container Apps Easy Auth handles SSO, app uses OBO downstream
# local = development: DefaultAzureCredential (uses your `az login` session)
AUTH_MODE=local

# === Entra ID (required when AUTH_MODE=sso) ===
# This is the Entra app that backs the Streamlit container itself.
# It must:
#   - Be configured as a web app with the Container Apps callback URL
#   - Have a client secret stored in Key Vault and injected via secretRef
#   - Have delegated permissions:
#       Microsoft Graph    -> Application.ReadWrite.OwnedBy   (create bot AAD apps)
#       Azure Service Mgmt -> user_impersonation              (ARM deploys)
#       Azure AI Services  -> user_impersonation              (Foundry listing)
ENTRA_TENANT_ID=<your-tenant-id-guid>
ENTRA_CLIENT_ID=<your-app-client-id-guid>
# CLIENT_SECRET is read from the env at runtime. In Container Apps,
# bind it via secretRef from Key Vault — do not hardcode here.
ENTRA_CLIENT_SECRET=<dev-only-secret>

# === Azure deployment scope ===
# The resource group that contains the privately-networked Foundry + APIM.
# The Streamlit app deploys publish-agent.bicep into this RG.
SUBSCRIPTION_ID=<sub-id-guid>
RESOURCE_GROUP=rg-<your-foundry-rg>

# === APIM bridge (output of bootstrap.bicep) ===
# These are pre-configured per tenant — the user just picks an agent.
APIM_NAME=apim-<your-apim>
FOUNDRY_BOT_API_NAME=foundry-bot

# === Key Vault for bot client secrets ===
# Every publish generates a fresh secret for the bot's Entra app. We push it
# straight to this vault so it never appears in browser memory after the
# success screen renders. The user account (OBO) needs the data-plane role
# 'Key Vault Secrets Officer' on this vault (RBAC mode).
BOT_SECRETS_KEYVAULT_NAME=kv-<your-kv>

# === Translator (output of bootstrap-translator.bicep) ===
# All five required. Container Apps Environment, ACR, and user-assigned MI
# are provisioned once per tenant; per-bot Container Apps are deployed by
# publish-agent.bicep.
TRANSLATOR_CAE_NAME=cae-translator-<suffix>
TRANSLATOR_CAE_DEFAULT_DOMAIN=<random>.swedencentral.azurecontainerapps.io
TRANSLATOR_ACR_NAME=acrtranslator<suffix>
TRANSLATOR_ACR_LOGIN_SERVER=acrtranslator<suffix>.azurecr.io
TRANSLATOR_MI_NAME=mi-translator-<suffix>
TRANSLATOR_MI_CLIENT_ID=<user-assigned-mi-client-id-guid>
TRANSLATOR_THREAD_TABLE_URL=https://sttranslator<suffix>.table.core.windows.net/

# === Shared-router publishing (one Container App for every agent) ===
# The publisher no longer deploys a per-bot Container App. Instead it writes
# ONE registry row per agent into this table, and the single shared translator
# container (env AGENT_REGISTRY_TABLE) routes by bot id.
#
# ONE-TIME setup this depends on:
#   1. One shared translator Container App running the router image with env
#      AGENT_REGISTRY_TABLE=<table> + THREAD_TABLE_URL + FOUNDRY_PROJECT_ENDPOINT.
#   2. One APIM operation POST /agents/{agentId}/messages whose policy forwards
#      to that shared container's internal FQDN.
#   3. The publisher identity (OBO) needs 'Storage Table Data Contributor' on
#      the translator storage account (to write registry rows).
AGENT_REGISTRY_TABLE=agents
# Auto-derived from the agent's tools; this is only the fallback default.
DEFAULT_AUTH_MODE=oauth
# MCP resource scope requested for per-user sign-in (Boundary A). Fallback until
# the MCP server advertises OAuth protected-resource metadata for auto-discovery.
DEFAULT_MCP_SCOPE=api://<mcp-resource-app-id>/user_impersonation
# ONE shared OAuth client, pre-authorized on the MCP resource app, reused by all
# agents so no per-bot pre-authorization is needed. Leave unset to fall back to
# each bot's own app id/secret (then each bot must be pre-authorized instead).
SHARED_OAUTH_CLIENT_ID=<pre-authorized-client-app-id-guid>
SHARED_OAUTH_CLIENT_SECRET=<shared-oauth-client-secret>
# Public base URL where the container's /api/oauth/callback is reachable (APIM).
# Defaults to https://<APIM_NAME>.azure-api.net if unset.
OAUTH_REDIRECT_BASE_URL=https://apim-<your-apim>.azure-api.net

# === Streamlit ===
STREAMLIT_SERVER_PORT=8000
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
