# ─────────────────────────────────────────────────────────────────────
# Hosted-agent chat app — environment variables
# Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────

# === Auth mode ===
# local = DefaultAzureCredential (your `az login` session)
# sso   = Container Apps Easy Auth + on-behalf-of
AUTH_MODE=local

# Required only when AUTH_MODE=sso
ENTRA_TENANT_ID=<tenant-guid>
ENTRA_CLIENT_ID=<app-client-id-guid>
ENTRA_CLIENT_SECRET=<dev-only-secret>

# === Foundry target ===
# Project endpoint: https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# Deployed hosted-agent name (the identifier IS the name for hosted/prompt agents)
HOSTED_AGENT_NAME=<hosted-agent-name>
# Optional: override the full Responses URL (else derived from the two above)
# AGENT_RESPONSES_URL=
# Informational (the hosted agent owns its own model)
MODEL=gpt-4.1
# Token audience/scope for the Foundry data plane
FOUNDRY_SCOPE=https://ai.azure.com/.default
# Preview api-version for the OpenAI v1 containers surface
CONTAINERS_API_VERSION=2025-04-01-preview

# === Container / Code Interpreter behaviour ===
# auto | explicit | off
CONTAINER_MODE=auto
# Required when CONTAINER_MODE=explicit
# EXPLICIT_CONTAINER_ID=cntr_...
SEND_CONTAINER_HINT=true
BIND_CODE_INTERPRETER_TOOL=true

# === Tool identity ===
# MCP server label used to recognise MCP tool function calls in the response
MCP_SERVER_LABEL=mcp

# === HTTP ===
REQUEST_TIMEOUT_SECONDS=120
VERIFY_TLS=true
# CA_BUNDLE_PATH=/path/to/corp-ca.pem   # for private-endpoint / proxy TLS
MAX_TEMPLATE_BYTES=26214400

# === Streamlit ===
STREAMLIT_SERVER_PORT=8502
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
