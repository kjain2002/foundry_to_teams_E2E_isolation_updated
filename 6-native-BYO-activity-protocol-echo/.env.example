# Local run / dev config for the Activity-protocol bridge agent.
# Copy to .env and fill in. Do NOT commit real values.
#
# For azd deploy, set these in .azure/<env-name>/.env (they map to the ${...}
# placeholders in azure.yaml). For local runs (docker or `python main.py`),
# python-dotenv reads .env in this folder.

# Foundry project endpoint
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-account>.services.ai.azure.com/api/projects/<your-project>

# The existing deployed agent we forward each turn to (contains the real brain)
TARGET_AGENT_NAME=<your-existing-agent-name>

# Azure Bot OAuth connection NAME configured on the bot resource
# (only needed if your MCP tool needs per-user OBO; safe to leave empty for the echo test)
OAUTH_CONNECTION_NAME=
OBO_CONNECTION_NAME=

# MCP resource scope for the user OBO token (e.g. api://<mcp-app-id>/user_impersonation)
# Leave blank if not doing OBO
MCP_USER_SCOPE=

# Storage account (blob) used for durable state (prefs, asked flag, history).
# The agent's managed identity needs "Storage Blob Data Contributor" on it.
STATE_STORAGE_ACCOUNT=<your-storage-account>

# Logging
LOG_LEVEL=INFO
