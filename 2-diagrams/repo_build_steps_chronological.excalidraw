    {
      "type": "text",
      "id": "s9_t",
      "x": 188,
      "y": 1162,
      "width": 670,
      "height": 66,
      "text": "Built a small translator service that runs privately inside the network and\nconverts Teams bot messages into Foundry agent calls and back. It runs on a\ncontainer platform with its own registry and managed identity.",
      "fontSize": 14,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "textAlign": "left",
      "verticalAlign": "middle",
