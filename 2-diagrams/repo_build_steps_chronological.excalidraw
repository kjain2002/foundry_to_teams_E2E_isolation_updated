    {
      "type": "text",
      "id": "s3_t",
      "x": 188,
      "y": 427,
      "width": 670,
      "height": 51,
      "text": "Created the Foundry account and project with a GPT-4.1 deployment, and\nturned off public network access so it is reachable only inside the VNet.",
      "fontSize": 14,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "textAlign": "left",
      "verticalAlign": "middle",
      "version": 2,
      "versionNonce": 713929884,
      "index": "aP",
