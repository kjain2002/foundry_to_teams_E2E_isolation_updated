    {
      "type": "text",
      "id": "s1_t",
      "x": 188,
      "y": 172,
      "width": 670,
      "height": 66,
      "text": "Decided the architecture: keep Foundry fully private and put an API gateway\nin front as the public entry point for Teams traffic. Use a managed identity\nowned by a security group as the bot identity (so the team shares ownership).",
      "fontSize": 14,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "textAlign": "left",
      "verticalAlign": "middle",
      "version": 2,
      "versionNonce": 285279772,
      "index": "aF",
      "isDeleted": false,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "seed": 1,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1781209358896,
      "link": null,
      "locked": false,
      "containerId": null,
      "originalText": "Decided the architecture: keep Foundry fully private and put an API gateway\nin front as the public entry point for Teams traffic. Use a managed identity\nowned by a security group as the bot identity (so the team shares ownership).",
      "autoResize": true,
      "lineHeight": 1.5714285714285714
    },
