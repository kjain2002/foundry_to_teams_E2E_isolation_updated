    {
      "type": "text",
      "id": "why_t",
      "x": 1085.0512211451098,
      "y": 729.6446297686837,
      "width": 388,
      "height": 140,
      "text": "Why no container per agent?\n\n• The container has NO agent-specific code —\n  it just moves Bot Protocol ↔ Foundry.\n• Tools (Genie, search…) execute in Foundry,\n  not in the container.\n• So a new agent needs a new ROW, not a new\n  image, deploy, or scale unit.",
      "fontSize": 13,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "why",
      "version": 240,
      "versionNonce": 1473880514,
      "index": "ac",
      "isDeleted": false,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "seed": 1,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1785499954835,
      "link": null,
      "locked": false,
      "originalText": "Why no container per agent?\n\n• The container has NO agent-specific code —\n  it just moves Bot Protocol ↔ Foundry.\n• Tools (Genie, search…) execute in Foundry,\n  not in the container.\n• So a new agent needs a new ROW, not a new\n  image, deploy, or scale unit.",
      "autoResize": true,
      "lineHeight": 1.3461538461538463
    },
