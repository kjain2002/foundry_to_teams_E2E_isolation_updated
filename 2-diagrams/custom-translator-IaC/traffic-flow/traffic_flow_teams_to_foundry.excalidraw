  "appState": { "viewBackgroundColor": "#ffffff" },
  "elements": [
    { "type": "text", "id": "title", "x": 60, "y": 20, "width": 880, "height": 40,
      "text": "Traffic Flow: Teams Message \u2192 Private Foundry \u2192 Back", "fontSize": 26, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "top" },
    { "type": "text", "id": "subtitle", "x": 60, "y": 62, "width": 880, "height": 22,
      "text": "Foundry has publicNetworkAccess = Disabled / no public IP \u2014 only APIM is reachable from the internet.", "fontSize": 14, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "top" },

    { "type": "rectangle", "id": "legend", "x": 950, "y": 18, "width": 400, "height": 180,
      "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1,
      "roundness": { "type": 3 } },
    { "type": "text", "id": "legend_t", "x": 965, "y": 28, "width": 360, "height": 22,
      "text": "Legend", "fontSize": 15, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "top" },
    { "type": "rectangle", "id": "lg_saas", "x": 965, "y": 58, "width": 26, "height": 18,
      "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 1, "roundness": { "type": 3 } },
    { "type": "text", "id": "lg_saas_t", "x": 1000, "y": 58, "width": 340, "height": 18,
      "text": "Public Microsoft SaaS (Teams / Bot Channel Svc)", "fontSize": 13, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "top" },
    { "type": "rectangle", "id": "lg_apim", "x": 965, "y": 86, "width": 26, "height": 18,
      "strokeColor": "#F7630C", "backgroundColor": "#FFF4CE", "fillStyle": "solid", "strokeWidth": 1, "roundness": { "type": 3 } },
    { "type": "text", "id": "lg_apim_t", "x": 1000, "y": 86, "width": 340, "height": 18,
      "text": "Public ingress \u2014 APIM only (JWT-locked)", "fontSize": 13, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "top" },
    { "type": "rectangle", "id": "lg_vnet", "x": 965, "y": 114, "width": 26, "height": 18,
      "strokeColor": "#107C10", "backgroundColor": "#DFF6DD", "fillStyle": "solid", "strokeWidth": 1, "roundness": { "type": 3 } },
    { "type": "text", "id": "lg_vnet_t", "x": 1000, "y": 114, "width": 340, "height": 18,
      "text": "Private VNet hop (no public IP)", "fontSize": 13, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "top" },
    { "type": "rectangle", "id": "lg_agent", "x": 965, "y": 142, "width": 26, "height": 18,
      "strokeColor": "#5C2D91", "backgroundColor": "#E8DAEF", "fillStyle": "solid", "strokeWidth": 1, "roundness": { "type": 3 } },
    { "type": "text", "id": "lg_agent_t", "x": 1000, "y": 142, "width": 340, "height": 18,
      "text": "Foundry agent (publicNetworkAccess = Disabled)", "fontSize": 13, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "top" },
    { "type": "text", "id": "lg_arrow_t", "x": 965, "y": 170, "width": 360, "height": 18,
      "text": "Steps 1\u20135 = inbound \u00b7 Steps 6\u20138 = reply", "fontSize": 12, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "top" },

    { "type": "line", "id": "spine", "x": 115, "y": 150, "width": 0, "height": 770,
      "strokeColor": "#868e96", "strokeWidth": 2, "strokeStyle": "dashed", "points": [[0, 0], [0, 770]] },

    { "type": "rectangle", "id": "phaseA", "x": 60, "y": 110, "width": 810, "height": 34,
      "strokeColor": "#495057", "backgroundColor": "#dee2e6", "fillStyle": "solid", "strokeWidth": 1, "roundness": { "type": 3 },
      "boundElements": [{ "type": "text", "id": "phaseA_t" }] },
    { "type": "text", "id": "phaseA_t", "x": 70, "y": 118, "width": 790, "height": 18,
      "text": "INBOUND  \u2014  Teams  \u2192  private Foundry agent", "fontSize": 15, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "phaseA" },

    { "type": "ellipse", "id": "c1", "x": 90, "y": 163, "width": 50, "height": 50,
      "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "boundElements": [{ "type": "text", "id": "c1_t" }] },
    { "type": "text", "id": "c1_t", "x": 105, "y": 178, "width": 20, "height": 20, "text": "1", "fontSize": 18, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "c1" },
    { "type": "rectangle", "id": "s1", "x": 170, "y": 158, "width": 700, "height": 66,
      "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 } },
    { "type": "text", "id": "s1_t", "x": 188, "y": 170, "width": 664, "height": 44,
      "text": "Teams user sends a message. Teams relays it over HTTPS to the\nBot Framework Channel Service (Microsoft cloud \u2014 public).", "fontSize": 14, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "middle" },

    { "type": "ellipse", "id": "c2", "x": 90, "y": 243, "width": 50, "height": 50,
      "strokeColor": "#F7630C", "backgroundColor": "#FFF4CE", "fillStyle": "solid", "strokeWidth": 2, "boundElements": [{ "type": "text", "id": "c2_t" }] },
    { "type": "text", "id": "c2_t", "x": 105, "y": 258, "width": 20, "height": 20, "text": "2", "fontSize": 18, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "c2" },
    { "type": "rectangle", "id": "s2", "x": 170, "y": 238, "width": 700, "height": 66,
      "strokeColor": "#F7630C", "backgroundColor": "#FFF4CE", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 } },
    { "type": "text", "id": "s2_t", "x": 188, "y": 250, "width": 664, "height": 44,
      "text": "Channel Service POSTs /api/messages with a signed Bot JWT to\nAPIM's public FQDN \u2014 the ONLY public ingress into the VNet.", "fontSize": 14, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "middle" },

    { "type": "ellipse", "id": "c3", "x": 90, "y": 323, "width": 50, "height": 50,
      "strokeColor": "#F7630C", "backgroundColor": "#FFF4CE", "fillStyle": "solid", "strokeWidth": 2, "boundElements": [{ "type": "text", "id": "c3_t" }] },
    { "type": "text", "id": "c3_t", "x": 105, "y": 338, "width": 20, "height": 20, "text": "3", "fontSize": 18, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "c3" },
    { "type": "rectangle", "id": "s3", "x": 170, "y": 318, "width": 700, "height": 66,
      "strokeColor": "#F7630C", "backgroundColor": "#FFF4CE", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 } },
    { "type": "text", "id": "s3_t", "x": 188, "y": 330, "width": 664, "height": 44,
      "text": "APIM validates the JWT (iss = api.botframework.com, aud = bot AppId),\nthen set-backend routes to the translator's internal FQDN via CAE private DNS.", "fontSize": 13, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "middle" },

    { "type": "ellipse", "id": "c4", "x": 90, "y": 403, "width": 50, "height": 50,
      "strokeColor": "#107C10", "backgroundColor": "#DFF6DD", "fillStyle": "solid", "strokeWidth": 2, "boundElements": [{ "type": "text", "id": "c4_t" }] },
    { "type": "text", "id": "c4_t", "x": 105, "y": 418, "width": 20, "height": 20, "text": "4", "fontSize": 18, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "c4" },
    { "type": "rectangle", "id": "s4", "x": 170, "y": 398, "width": 700, "height": 66,
      "strokeColor": "#107C10", "backgroundColor": "#DFF6DD", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 } },
    { "type": "text", "id": "s4_t", "x": 188, "y": 410, "width": 664, "height": 44,
      "text": "Per-bot Translator Container App (FastAPI + botbuilder, internal CAE) receives\nthe Activity and calls the Foundry agent SDK over a private endpoint.", "fontSize": 13, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "middle" },

    { "type": "ellipse", "id": "c5", "x": 90, "y": 483, "width": 50, "height": 50,
      "strokeColor": "#5C2D91", "backgroundColor": "#E8DAEF", "fillStyle": "solid", "strokeWidth": 2, "boundElements": [{ "type": "text", "id": "c5_t" }] },
    { "type": "text", "id": "c5_t", "x": 105, "y": 498, "width": 20, "height": 20, "text": "5", "fontSize": 18, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "c5" },
    { "type": "rectangle", "id": "s5", "x": 170, "y": 478, "width": 700, "height": 70,
      "strokeColor": "#5C2D91", "backgroundColor": "#E8DAEF", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 } },
    { "type": "text", "id": "s5_t", "x": 188, "y": 490, "width": 664, "height": 48,
      "text": "Private DNS resolves Foundry to 10.x.x.x. The agent runs with publicNetworkAccess\n= Disabled; tools (AI Search, MCP Genie) execute inside Foundry under its own identity.", "fontSize": 13, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "middle" },

    { "type": "rectangle", "id": "phaseB", "x": 60, "y": 566, "width": 810, "height": 34,
      "strokeColor": "#495057", "backgroundColor": "#dee2e6", "fillStyle": "solid", "strokeWidth": 1, "roundness": { "type": 3 },
      "boundElements": [{ "type": "text", "id": "phaseB_t" }] },
    { "type": "text", "id": "phaseB_t", "x": 70, "y": 574, "width": 790, "height": 18,
      "text": "OUTBOUND  \u2014  Foundry reply  \u2192  Teams", "fontSize": 15, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "phaseB" },

    { "type": "ellipse", "id": "c6", "x": 90, "y": 619, "width": 50, "height": 50,
      "strokeColor": "#107C10", "backgroundColor": "#DFF6DD", "fillStyle": "solid", "strokeWidth": 2, "boundElements": [{ "type": "text", "id": "c6_t" }] },
    { "type": "text", "id": "c6_t", "x": 105, "y": 634, "width": 20, "height": 20, "text": "6", "fontSize": 18, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "c6" },
    { "type": "rectangle", "id": "s6", "x": 170, "y": 614, "width": 700, "height": 66,
      "strokeColor": "#107C10", "backgroundColor": "#DFF6DD", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 } },
    { "type": "text", "id": "s6_t", "x": 188, "y": 626, "width": 664, "height": 44,
      "text": "Agent returns its reply to the translator Container App \u2014\nstill entirely inside the VNet (private endpoint, no public hop).", "fontSize": 14, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "middle" },

    { "type": "ellipse", "id": "c7", "x": 90, "y": 699, "width": 50, "height": 50,
      "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "boundElements": [{ "type": "text", "id": "c7_t" }] },
    { "type": "text", "id": "c7_t", "x": 105, "y": 714, "width": 20, "height": 20, "text": "7", "fontSize": 18, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "c7" },
    { "type": "rectangle", "id": "s7", "x": 170, "y": 694, "width": 700, "height": 66,
      "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 } },
    { "type": "text", "id": "s7_t", "x": 188, "y": 706, "width": 664, "height": 44,
      "text": "Translator sends the reply Activity back out to the\nBot Framework Channel Service (Microsoft cloud).", "fontSize": 14, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "middle" },

    { "type": "ellipse", "id": "c8", "x": 90, "y": 779, "width": 50, "height": 50,
      "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "boundElements": [{ "type": "text", "id": "c8_t" }] },
    { "type": "text", "id": "c8_t", "x": 105, "y": 794, "width": 20, "height": 20, "text": "8", "fontSize": 18, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "c8" },
    { "type": "rectangle", "id": "s8", "x": 170, "y": 774, "width": 700, "height": 66,
      "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 } },
    { "type": "text", "id": "s8_t", "x": 188, "y": 786, "width": 664, "height": 44,
      "text": "Channel Service delivers it to Teams, which renders the\nagent's response back to the user.", "fontSize": 14, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "middle" },

    { "type": "rectangle", "id": "insight", "x": 170, "y": 870, "width": 700, "height": 110,
      "strokeColor": "#5C2D91", "backgroundColor": "#F3F2F1", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 } },
    { "type": "text", "id": "insight_t", "x": 188, "y": 882, "width": 664, "height": 88,
      "text": "Why it stays private:  Foundry has NO public IP. The only public ingress is APIM's\nFQDN, locked down by Bot-Framework JWT validation (iss + aud). The Bot \u2192 Foundry\nhop never leaves the VNet \u2014 it goes APIM \u2192 internal Container App \u2192 Foundry private\nendpoint (10.x.x.x). Tools (AI Search, MCP Genie) run inside the agent's identity.", "fontSize": 13, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "middle" }
  ]
}
