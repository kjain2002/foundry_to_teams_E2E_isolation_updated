    { "type": "text", "id": "phAt", "x": 70, "y": 88, "width": 850, "height": 18, "text": "PHASE A \u2014 PRIVATE FOUNDRY INFRASTRUCTURE  (deploy once)", "fontSize": 15, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "center", "verticalAlign": "middle", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3013, "index": "aC", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": "phA", "originalText": "PHASE A \u2014 PRIVATE FOUNDRY INFRASTRUCTURE  (deploy once)", "autoResize": true, "lineHeight": 1.2 },

    { "type": "ellipse", "id": "c1", "x": 90, "y": 130, "width": 50, "height": 50, "strokeColor": "#5C2D91", "backgroundColor": "#E8DAEF", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3014, "index": "aD", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [{"type":"text","id":"c1t"}], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "c1t", "x": 105, "y": 145, "width": 20, "height": 20, "text": "1", "fontSize": 18, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "center", "verticalAlign": "middle", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3015, "index": "aE", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": "c1", "originalText": "1", "autoResize": true, "lineHeight": 1.1 },
    { "type": "rectangle", "id": "s1", "x": 170, "y": 130, "width": 760, "height": 90, "strokeColor": "#5C2D91", "backgroundColor": "#E8DAEF", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3016, "index": "aF", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "s1t", "x": 188, "y": 142, "width": 730, "height": 66, "text": "Choose architecture: private Foundry (publicNetworkAccess=Disabled) + APIM as the\nonly public ingress + ONE shared translator Container App (registry-driven, serves all\nagents) + hosted-agent Responses API + self-service publisher (UI / CLI / notebook).", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "left", "verticalAlign": "top", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3017, "index": "aG", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": null, "originalText": "Choose architecture: private Foundry (publicNetworkAccess=Disabled) + APIM as the\nonly public ingress + ONE shared translator Container App (registry-driven, serves all\nagents) + hosted-agent Responses API + self-service publisher (UI / CLI / notebook).", "autoResize": true, "lineHeight": 1.57 },

    { "type": "ellipse", "id": "c2", "x": 90, "y": 240, "width": 50, "height": 50, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3018, "index": "aH", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [{"type":"text","id":"c2t"}], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "c2t", "x": 105, "y": 255, "width": 20, "height": 20, "text": "2", "fontSize": 18, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "center", "verticalAlign": "middle", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3019, "index": "aI", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": "c2", "originalText": "2", "autoResize": true, "lineHeight": 1.1 },
    { "type": "rectangle", "id": "s2", "x": 170, "y": 240, "width": 760, "height": 110, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3020, "index": "aJ", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "s2t", "x": 188, "y": 252, "width": 730, "height": 88, "text": "Deploy BYO VNet with four subnets: apim-subnet (APIM External mode), agent-subnet\n(Microsoft.App/environments delegation for Foundry runtimes), pe-subnet (private\nendpoints), cae-subnet (Container Apps Env). Add P2S VPN gateway (Entra ID / FIDO2\nauth) for developer + admin access into the private network.", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "left", "verticalAlign": "top", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3021, "index": "aK", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": null, "originalText": "Deploy BYO VNet with four subnets: apim-subnet (APIM External mode), agent-subnet\n(Microsoft.App/environments delegation for Foundry runtimes), pe-subnet (private\nendpoints), cae-subnet (Container Apps Env). Add P2S VPN gateway (Entra ID / FIDO2\nauth) for developer + admin access into the private network.", "autoResize": true, "lineHeight": 1.57 },

    { "type": "ellipse", "id": "c3", "x": 90, "y": 370, "width": 50, "height": 50, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3022, "index": "aL", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [{"type":"text","id":"c3t"}], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "c3t", "x": 105, "y": 385, "width": 20, "height": 20, "text": "3", "fontSize": 18, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "center", "verticalAlign": "middle", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3023, "index": "aM", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": "c3", "originalText": "3", "autoResize": true, "lineHeight": 1.1 },
    { "type": "rectangle", "id": "s3", "x": 170, "y": 370, "width": 760, "height": 90, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3024, "index": "aN", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "s3t", "x": 188, "y": 382, "width": 730, "height": 66, "text": "Deploy private endpoints + private DNS zones for: Foundry account (services.ai,\ncognitiveservices, openai), Azure AI Search, Azure Storage (blob), Cosmos DB.\nLink all DNS zones to the VNet via the hub DNS resolver.", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "left", "verticalAlign": "top", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3025, "index": "aO", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": null, "originalText": "Deploy private endpoints + private DNS zones for: Foundry account (services.ai,\ncognitiveservices, openai), Azure AI Search, Azure Storage (blob), Cosmos DB.\nLink all DNS zones to the VNet via the hub DNS resolver.", "autoResize": true, "lineHeight": 1.57 },

    { "type": "ellipse", "id": "c4", "x": 90, "y": 480, "width": 50, "height": 50, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3026, "index": "aP", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [{"type":"text","id":"c4t"}], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "c4t", "x": 105, "y": 495, "width": 20, "height": 20, "text": "4", "fontSize": 18, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "center", "verticalAlign": "middle", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3027, "index": "aQ", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": "c4", "originalText": "4", "autoResize": true, "lineHeight": 1.1 },
    { "type": "rectangle", "id": "s4", "x": 170, "y": 480, "width": 760, "height": 90, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3028, "index": "aR", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "s4t", "x": 188, "y": 492, "width": 730, "height": 66, "text": "Deploy Foundry account + project (AIServices) via Bicep (main.bicep) or Terraform.\nCreate account-level + project-level capability hosts (createCapHost.sh or REST API).\nAssign RBAC (AI Developer, AI Search Data, Storage, Cosmos roles) to project system MI.", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "left", "verticalAlign": "top", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3029, "index": "aS", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": null, "originalText": "Deploy Foundry account + project (AIServices) via Bicep (main.bicep) or Terraform.\nCreate account-level + project-level capability hosts (createCapHost.sh or REST API).\nAssign RBAC (AI Developer, AI Search Data, Storage, Cosmos roles) to project system MI.", "autoResize": true, "lineHeight": 1.57 },

    { "type": "ellipse", "id": "c5", "x": 90, "y": 590, "width": 50, "height": 50, "strokeColor": "#107C10", "backgroundColor": "#DFF6DD", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3030, "index": "aT", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [{"type":"text","id":"c5t"}], "updated": 1781209358896, "link": null, "locked": false },
