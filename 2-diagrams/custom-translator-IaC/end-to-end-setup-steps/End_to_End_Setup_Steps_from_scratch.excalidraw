    { "type": "text", "id": "s5t", "x": 188, "y": 605, "width": 730, "height": 44, "text": "\u2705  PHASE A DONE \u2014 Private Foundry is live (all resources private-endpoint only).\nReach it only via P2S VPN. Build the shared publishing platform next.", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "left", "verticalAlign": "top", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3033, "index": "aW", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": null, "originalText": "\u2705  PHASE A DONE \u2014 Private Foundry is live (all resources private-endpoint only).\nReach it only via P2S VPN. Build the shared publishing platform next.", "autoResize": true, "lineHeight": 1.57 },

    { "type": "rectangle", "id": "phB", "x": 60, "y": 680, "width": 870, "height": 34, "strokeColor": "#495057", "backgroundColor": "#dee2e6", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3034, "index": "aX", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [{"type":"text","id":"phBt"}], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "phBt", "x": 70, "y": 688, "width": 850, "height": 18, "text": "PHASE B \u2014 SHARED PUBLISHING PLATFORM  (deploy once, use for all agents)", "fontSize": 15, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "center", "verticalAlign": "middle", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3035, "index": "aY", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": "phB", "originalText": "PHASE B \u2014 SHARED PUBLISHING PLATFORM  (deploy once, use for all agents)", "autoResize": true, "lineHeight": 1.2 },

    { "type": "ellipse", "id": "c6", "x": 90, "y": 730, "width": 50, "height": 50, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3036, "index": "aZ", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [{"type":"text","id":"c6t"}], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "c6t", "x": 105, "y": 745, "width": 20, "height": 20, "text": "6", "fontSize": 18, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "center", "verticalAlign": "middle", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3037, "index": "b0", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": "c6", "originalText": "6", "autoResize": true, "lineHeight": 1.1 },
    { "type": "rectangle", "id": "s6", "x": 170, "y": 730, "width": 760, "height": 90, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3038, "index": "b1", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "s6t", "x": 188, "y": 742, "width": 730, "height": 66, "text": "Deploy APIM (External VNet mode, apim-subnet). Add API-level validate-jwt policy (Bot\nFramework issuer). Create the foundry-bot API with a base inbound policy. APIM is the\nonly public surface for all Teams traffic \u2014 everything behind it stays in the VNet.", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "left", "verticalAlign": "top", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3039, "index": "b2", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": null, "originalText": "Deploy APIM (External VNet mode, apim-subnet). Add API-level validate-jwt policy (Bot\nFramework issuer). Create the foundry-bot API with a base inbound policy. APIM is the\nonly public surface for all Teams traffic \u2014 everything behind it stays in the VNet.", "autoResize": true, "lineHeight": 1.57 },

    { "type": "ellipse", "id": "c7", "x": 90, "y": 840, "width": 50, "height": 50, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3040, "index": "b3", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [{"type":"text","id":"c7t"}], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "c7t", "x": 105, "y": 855, "width": 20, "height": 20, "text": "7", "fontSize": 18, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "center", "verticalAlign": "middle", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3041, "index": "b4", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": "c7", "originalText": "7", "autoResize": true, "lineHeight": 1.1 },
    { "type": "rectangle", "id": "s7", "x": 170, "y": 840, "width": 760, "height": 110, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3042, "index": "b5", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "s7t", "x": 188, "y": 852, "width": 730, "height": 88, "text": "Build translator container image (3-custom-translator/translator/): FastAPI app speaking\nBot Framework Activity Protocol \u2194 Foundry Responses API. Push image to ACR.\nDeploy Container Apps Env (internal, cae-subnet) + shared Container App (UAMI with\nAcrPull + Azure AI Developer roles). Set THREAD_TABLE_URL in the container env.", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "left", "verticalAlign": "top", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3043, "index": "b6", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": null, "originalText": "Build translator container image (3-custom-translator/translator/): FastAPI app speaking\nBot Framework Activity Protocol \u2194 Foundry Responses API. Push image to ACR.\nDeploy Container Apps Env (internal, cae-subnet) + shared Container App (UAMI with\nAcrPull + Azure AI Developer roles). Set THREAD_TABLE_URL in the container env.", "autoResize": true, "lineHeight": 1.57 },

    { "type": "ellipse", "id": "c8", "x": 90, "y": 970, "width": 50, "height": 50, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3044, "index": "b7", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [{"type":"text","id":"c8t"}], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "c8t", "x": 105, "y": 985, "width": 20, "height": 20, "text": "8", "fontSize": 18, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "center", "verticalAlign": "middle", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3045, "index": "b8", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": "c8", "originalText": "8", "autoResize": true, "lineHeight": 1.1 },
    { "type": "rectangle", "id": "s8", "x": 170, "y": 970, "width": 760, "height": 90, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3046, "index": "b9", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "s8t", "x": 188, "y": 982, "width": 730, "height": 66, "text": "Create Azure Storage account. Add two Azure Tables: agents (agent registry:\nbotId \u2192 agentId \u2192 authMode) and tokens (OAuth token store: per-(botId,userId) tokens).\nSet AGENT_REGISTRY_TABLE and THREAD_TABLE_URL on the container app.", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "left", "verticalAlign": "top", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3047, "index": "bA", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": null, "originalText": "Create Azure Storage account. Add two Azure Tables: agents (agent registry:\nbotId \u2192 agentId \u2192 authMode) and tokens (OAuth token store: per-(botId,userId) tokens).\nSet AGENT_REGISTRY_TABLE and THREAD_TABLE_URL on the container app.", "autoResize": true, "lineHeight": 1.57 },

    { "type": "ellipse", "id": "c9", "x": 90, "y": 1080, "width": 50, "height": 50, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3048, "index": "bB", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [{"type":"text","id":"c9t"}], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "c9t", "x": 105, "y": 1095, "width": 20, "height": 20, "text": "9", "fontSize": 18, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "center", "verticalAlign": "middle", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3049, "index": "bC", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": "c9", "originalText": "9", "autoResize": true, "lineHeight": 1.1 },
    { "type": "rectangle", "id": "s9", "x": 170, "y": 1080, "width": 760, "height": 110, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3050, "index": "bD", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "s9t", "x": 188, "y": 1092, "width": 730, "height": 88, "text": "Create two shared Entra apps for MCP OAuth:\n  \u2022 MCP resource app: exposes api://<app-id>/user_impersonation scope.\n  \u2022 OAuth client app: used by the container + publisher for OBO token requests.\nOn the resource app \u2192 \u2018Expose an API\u2019 \u2192 pre-authorize the OAuth client (no admin needed).", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "left", "verticalAlign": "top", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3051, "index": "bE", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": null, "originalText": "Create two shared Entra apps for MCP OAuth:\n  \u2022 MCP resource app: exposes api://<app-id>/user_impersonation scope.\n  \u2022 OAuth client app: used by the container + publisher for OBO token requests.\nOn the resource app \u2192 \u2018Expose an API\u2019 \u2192 pre-authorize the OAuth client (no admin needed).", "autoResize": true, "lineHeight": 1.57 },

    { "type": "ellipse", "id": "c10", "x": 90, "y": 1210, "width": 50, "height": 50, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3052, "index": "bF", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [{"type":"text","id":"c10t"}], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "c10t", "x": 100, "y": 1225, "width": 30, "height": 20, "text": "10", "fontSize": 18, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "center", "verticalAlign": "middle", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3053, "index": "bG", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": "c10", "originalText": "10", "autoResize": true, "lineHeight": 1.1 },
    { "type": "rectangle", "id": "s10", "x": 170, "y": 1210, "width": 760, "height": 90, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3054, "index": "bH", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "s10t", "x": 188, "y": 1222, "width": 730, "height": 66, "text": "Create Key Vault. Assign Key Vault Secrets Officer to your deployment identity (the\nidentity that runs the publisher). Set BOT_SECRETS_KEYVAULT_NAME in publisher config.\nThe publisher writes each bot\u2019s Entra app secret here as \u2018bot-<name>-secret\u2019.", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "left", "verticalAlign": "top", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3055, "index": "bI", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": null, "originalText": "Create Key Vault. Assign Key Vault Secrets Officer to your deployment identity (the\nidentity that runs the publisher). Set BOT_SECRETS_KEYVAULT_NAME in publisher config.\nThe publisher writes each bot\u2019s Entra app secret here as \u2018bot-<name>-secret\u2019.", "autoResize": true, "lineHeight": 1.57 },

    { "type": "ellipse", "id": "c11", "x": 90, "y": 1320, "width": 50, "height": 50, "strokeColor": "#107C10", "backgroundColor": "#DFF6DD", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3056, "index": "bJ", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [{"type":"text","id":"c11t"}], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "c11t", "x": 100, "y": 1335, "width": 30, "height": 20, "text": "11", "fontSize": 18, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "center", "verticalAlign": "middle", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3057, "index": "bK", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": "c11", "originalText": "11", "autoResize": true, "lineHeight": 1.1 },
    { "type": "rectangle", "id": "s11", "x": 170, "y": 1320, "width": 760, "height": 70, "strokeColor": "#107C10", "backgroundColor": "#DFF6DD", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3058, "index": "bL", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "s11t", "x": 188, "y": 1335, "width": 730, "height": 44, "text": "\u2705  PHASE B DONE \u2014 APIM, Container App, registry tables, Entra apps, Key Vault\nare all configured. No agents published yet. Ready for the publisher.", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "left", "verticalAlign": "top", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3059, "index": "bM", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": null, "originalText": "\u2705  PHASE B DONE \u2014 APIM, Container App, registry tables, Entra apps, Key Vault\nare all configured. No agents published yet. Ready for the publisher.", "autoResize": true, "lineHeight": 1.57 },

    { "type": "rectangle", "id": "phC", "x": 60, "y": 1410, "width": 870, "height": 34, "strokeColor": "#495057", "backgroundColor": "#dee2e6", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3060, "index": "bN", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [{"type":"text","id":"phCt"}], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "phCt", "x": 70, "y": 1418, "width": 850, "height": 18, "text": "PHASE C \u2014 PUBLISHER SETUP  (configure once, use for every agent publish)", "fontSize": 15, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "center", "verticalAlign": "middle", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3061, "index": "bO", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": "phC", "originalText": "PHASE C \u2014 PUBLISHER SETUP  (configure once, use for every agent publish)", "autoResize": true, "lineHeight": 1.2 },

    { "type": "ellipse", "id": "c12", "x": 90, "y": 1460, "width": 50, "height": 50, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3062, "index": "bP", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [{"type":"text","id":"c12t"}], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "c12t", "x": 100, "y": 1475, "width": 30, "height": 20, "text": "12", "fontSize": 18, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "center", "verticalAlign": "middle", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3063, "index": "bQ", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": "c12", "originalText": "12", "autoResize": true, "lineHeight": 1.1 },
    { "type": "rectangle", "id": "s12", "x": 170, "y": 1460, "width": 760, "height": 110, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3064, "index": "bR", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "s12t", "x": 188, "y": 1472, "width": 730, "height": 88, "text": "Configure publisher (3-custom-translator/streamlit_app/):\n  Copy-Item .env.example .env   # then edit\nSet: SUBSCRIPTION_ID, RESOURCE_GROUP, APIM_NAME, FOUNDRY_ACCOUNT, FOUNDRY_PROJECT,\nBOT_SECRETS_KEYVAULT_NAME, SHARED_OAUTH_CLIENT_ID/SECRET, DEFAULT_MCP_SCOPE, OAUTH_REDIRECT_BASE_URL.", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "left", "verticalAlign": "top", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3065, "index": "bS", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": null, "originalText": "Configure publisher (3-custom-translator/streamlit_app/):\n  Copy-Item .env.example .env   # then edit\nSet: SUBSCRIPTION_ID, RESOURCE_GROUP, APIM_NAME, FOUNDRY_ACCOUNT, FOUNDRY_PROJECT,\nBOT_SECRETS_KEYVAULT_NAME, SHARED_OAUTH_CLIENT_ID/SECRET, DEFAULT_MCP_SCOPE, OAUTH_REDIRECT_BASE_URL.", "autoResize": true, "lineHeight": 1.57 },

    { "type": "ellipse", "id": "c13", "x": 90, "y": 1590, "width": 50, "height": 50, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3066, "index": "bT", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [{"type":"text","id":"c13t"}], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "c13t", "x": 100, "y": 1605, "width": 30, "height": 20, "text": "13", "fontSize": 18, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "center", "verticalAlign": "middle", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3067, "index": "bU", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": "c13", "originalText": "13", "autoResize": true, "lineHeight": 1.1 },
    { "type": "rectangle", "id": "s13", "x": 170, "y": 1590, "width": 760, "height": 90, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3068, "index": "bV", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "s13t", "x": 188, "y": 1602, "width": 730, "height": 66, "text": "Run the publisher. Three options \u2014 all call the same publisher.py:\n  3a) Streamlit UI:  python -m streamlit run app.py  (localhost:8501)\n  3b) Notebook:  open notebook_publisher/publish-agent-via-shared-container.ipynb\n  3c) CLI:  ./publish-agent.ps1 -ResourceGroup ... -AgentId ... -BotShortName ...", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "left", "verticalAlign": "top", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3069, "index": "bW", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": null, "originalText": "Run the publisher. Three options \u2014 all call the same publisher.py:\n  3a) Streamlit UI:  python -m streamlit run app.py  (localhost:8501)\n  3b) Notebook:  open notebook_publisher/publish-agent-via-shared-container.ipynb\n  3c) CLI:  ./publish-agent.ps1 -ResourceGroup ... -AgentId ... -BotShortName ...", "autoResize": true, "lineHeight": 1.57 },

    { "type": "ellipse", "id": "c14", "x": 90, "y": 1700, "width": 50, "height": 50, "strokeColor": "#107C10", "backgroundColor": "#DFF6DD", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3070, "index": "bX", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [{"type":"text","id":"c14t"}], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "c14t", "x": 100, "y": 1715, "width": 30, "height": 20, "text": "14", "fontSize": 18, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "center", "verticalAlign": "middle", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3071, "index": "bY", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": "c14", "originalText": "14", "autoResize": true, "lineHeight": 1.1 },
    { "type": "rectangle", "id": "s14", "x": 170, "y": 1700, "width": 760, "height": 70, "strokeColor": "#107C10", "backgroundColor": "#DFF6DD", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3072, "index": "bZ", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "s14t", "x": 188, "y": 1715, "width": 730, "height": 44, "text": "\u2705  PHASE C DONE \u2014 Publisher is running. Can now publish any Foundry agent to\nTeams with one click or one command. Repeat Phase D for each new agent.", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "left", "verticalAlign": "top", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3073, "index": "c0", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": null, "originalText": "\u2705  PHASE C DONE \u2014 Publisher is running. Can now publish any Foundry agent to\nTeams with one click or one command. Repeat Phase D for each new agent.", "autoResize": true, "lineHeight": 1.57 },

    { "type": "rectangle", "id": "phD", "x": 60, "y": 1790, "width": 870, "height": 34, "strokeColor": "#495057", "backgroundColor": "#dee2e6", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3074, "index": "c1", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [{"type":"text","id":"phDt"}], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "phDt", "x": 70, "y": 1798, "width": 850, "height": 18, "text": "PHASE D \u2014 PUBLISH AN AGENT TO TEAMS  (repeat per agent)", "fontSize": 15, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "center", "verticalAlign": "middle", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3075, "index": "c2", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": "phD", "originalText": "PHASE D \u2014 PUBLISH AN AGENT TO TEAMS  (repeat per agent)", "autoResize": true, "lineHeight": 1.2 },

    { "type": "ellipse", "id": "c15", "x": 90, "y": 1840, "width": 50, "height": 50, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3076, "index": "c3", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [{"type":"text","id":"c15t"}], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "c15t", "x": 100, "y": 1855, "width": 30, "height": 20, "text": "15", "fontSize": 18, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "center", "verticalAlign": "middle", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3077, "index": "c4", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": "c15", "originalText": "15", "autoResize": true, "lineHeight": 1.1 },
    { "type": "rectangle", "id": "s15", "x": 170, "y": 1840, "width": 760, "height": 90, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3078, "index": "c5", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "s15t", "x": 188, "y": 1852, "width": 730, "height": 66, "text": "Create the Foundry agent in the portal or via SDK. Add tools: AI Search grounding,\nCode Interpreter, MCP tools. Test all tools in the Foundry playground first \u2014 confirm\nevery tool returns results before publishing to Teams.", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "left", "verticalAlign": "top", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3079, "index": "c6", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": null, "originalText": "Create the Foundry agent in the portal or via SDK. Add tools: AI Search grounding,\nCode Interpreter, MCP tools. Test all tools in the Foundry playground first \u2014 confirm\nevery tool returns results before publishing to Teams.", "autoResize": true, "lineHeight": 1.57 },

    { "type": "ellipse", "id": "c16", "x": 90, "y": 1950, "width": 50, "height": 50, "strokeColor": "#5C2D91", "backgroundColor": "#E8DAEF", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3080, "index": "c7", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [{"type":"text","id":"c16t"}], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "c16t", "x": 100, "y": 1965, "width": 30, "height": 20, "text": "16", "fontSize": 18, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "center", "verticalAlign": "middle", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3081, "index": "c8", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": "c16", "originalText": "16", "autoResize": true, "lineHeight": 1.1 },
    { "type": "rectangle", "id": "s16", "x": 170, "y": 1950, "width": 760, "height": 90, "strokeColor": "#5C2D91", "backgroundColor": "#E8DAEF", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3082, "index": "c9", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "s16t", "x": 188, "y": 1962, "width": 730, "height": 66, "text": "(Only if the agent has an MCP tool needing per-user auth.) In Foundry, set the MCP\ntool\u2019s OAuth connection to: Identity Passthrough \u2192 Custom. Enter the shared OAuth\nclient app ID + api://<resource-app-id>/user_impersonation scope. Skip for grounding-only agents.", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "left", "verticalAlign": "top", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3083, "index": "cA", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": null, "originalText": "(Only if the agent has an MCP tool needing per-user auth.) In Foundry, set the MCP\ntool\u2019s OAuth connection to: Identity Passthrough \u2192 Custom. Enter the shared OAuth\nclient app ID + api://<resource-app-id>/user_impersonation scope. Skip for grounding-only agents.", "autoResize": true, "lineHeight": 1.57 },

    { "type": "ellipse", "id": "c17", "x": 90, "y": 2060, "width": 50, "height": 50, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3084, "index": "cB", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [{"type":"text","id":"c17t"}], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "c17t", "x": 100, "y": 2075, "width": 30, "height": 20, "text": "17", "fontSize": 18, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "center", "verticalAlign": "middle", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3085, "index": "cC", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": "c17", "originalText": "17", "autoResize": true, "lineHeight": 1.1 },
    { "type": "rectangle", "id": "s17", "x": 170, "y": 2060, "width": 760, "height": 90, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3086, "index": "cD", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "s17t", "x": 188, "y": 2072, "width": 730, "height": 66, "text": "Run the publisher for this agent (UI / notebook / CLI). Enter: agentId, display name,\nbot short name. Publisher automatically creates: Entra app + Azure Bot (F0) + Teams\nchannel + APIM operation + registry row + Teams .zip. Zero new compute.", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "left", "verticalAlign": "top", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3087, "index": "cE", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": null, "originalText": "Run the publisher for this agent (UI / notebook / CLI). Enter: agentId, display name,\nbot short name. Publisher automatically creates: Entra app + Azure Bot (F0) + Teams\nchannel + APIM operation + registry row + Teams .zip. Zero new compute.", "autoResize": true, "lineHeight": 1.57 },

    { "type": "ellipse", "id": "c18", "x": 90, "y": 2170, "width": 50, "height": 50, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3088, "index": "cF", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [{"type":"text","id":"c18t"}], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "c18t", "x": 100, "y": 2185, "width": 30, "height": 20, "text": "18", "fontSize": 18, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "center", "verticalAlign": "middle", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3089, "index": "cG", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": "c18", "originalText": "18", "autoResize": true, "lineHeight": 1.1 },
    { "type": "rectangle", "id": "s18", "x": 170, "y": 2170, "width": 760, "height": 90, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3090, "index": "cH", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "s18t", "x": 188, "y": 2182, "width": 730, "height": 66, "text": "Upload out/<bot-short-name>.zip to Teams: Apps \u2192 Manage your apps \u2192 Upload a\ncustom app. Message the agent. For per-user MCP tools: click the consent card once;\nthe agent then calls the tool with your real Entra identity (Boundary A proven).", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "left", "verticalAlign": "top", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3091, "index": "cI", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": null, "originalText": "Upload out/<bot-short-name>.zip to Teams: Apps \u2192 Manage your apps \u2192 Upload a\ncustom app. Message the agent. For per-user MCP tools: click the consent card once;\nthe agent then calls the tool with your real Entra identity (Boundary A proven).", "autoResize": true, "lineHeight": 1.57 },

    { "type": "ellipse", "id": "c19", "x": 90, "y": 2280, "width": 50, "height": 50, "strokeColor": "#107C10", "backgroundColor": "#DFF6DD", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3092, "index": "cJ", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [{"type":"text","id":"c19t"}], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "c19t", "x": 100, "y": 2295, "width": 30, "height": 20, "text": "19", "fontSize": 18, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "center", "verticalAlign": "middle", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3093, "index": "cK", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": "c19", "originalText": "19", "autoResize": true, "lineHeight": 1.1 },
    { "type": "rectangle", "id": "s19", "x": 170, "y": 2280, "width": 760, "height": 70, "strokeColor": "#107C10", "backgroundColor": "#DFF6DD", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3094, "index": "cL", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "s19t", "x": 188, "y": 2295, "width": 730, "height": 44, "text": "\u2705  PHASE D DONE \u2014 Agent is live in Teams. Repeat steps 15\u201318 for each new agent.\nEach publish takes minutes. Zero new infrastructure.", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "left", "verticalAlign": "top", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3095, "index": "cM", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": null, "originalText": "\u2705  PHASE D DONE \u2014 Agent is live in Teams. Repeat steps 15\u201318 for each new agent.\nEach publish takes minutes. Zero new infrastructure.", "autoResize": true, "lineHeight": 1.57 },

    { "type": "rectangle", "id": "phE", "x": 60, "y": 2370, "width": 870, "height": 34, "strokeColor": "#495057", "backgroundColor": "#dee2e6", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3096, "index": "cN", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [{"type":"text","id":"phEt"}], "updated": 1781209358896, "link": null, "locked": false },
    { "type": "text", "id": "phEt", "x": 70, "y": 2378, "width": 850, "height": 18, "text": "PHASE E \u2014 HOSTED AGENT + CODE INTERPRETER + FILE ATTACHMENTS  (optional feature unlock)", "fontSize": 15, "fontFamily": 2, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "textAlign": "center", "verticalAlign": "middle", "roughness": 1, "opacity": 100, "angle": 0, "version": 2, "versionNonce": 3097, "index": "cO", "isDeleted": false, "seed": 1, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1781209358896, "link": null, "locked": false, "containerId": "phE", "originalText": "PHASE E \u2014 HOSTED AGENT + CODE INTERPRETER + FILE ATTACHMENTS  (optional feature unlock)", "autoResize": true, "lineHeight": 1.2 },

