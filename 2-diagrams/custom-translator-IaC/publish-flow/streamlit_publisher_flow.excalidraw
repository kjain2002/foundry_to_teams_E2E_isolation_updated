    { "type": "text", "id": "phaseB_t", "x": 70, "y": 538, "width": 790, "height": 18,
      "text": "WHAT THE APP DOES BEHIND THE SCENES  (automatic, after you click Publish)", "fontSize": 15, "fontFamily": 2,
