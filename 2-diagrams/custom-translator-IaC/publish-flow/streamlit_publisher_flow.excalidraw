    { "type": "text", "id": "s11_t", "x": 188, "y": 958, "width": 670, "height": 34,
      "text": "Packages a ready-to-install Teams app file (.zip) with the bot's name, icons, and details.", "fontSize": 14, "fontFamily": 2,
