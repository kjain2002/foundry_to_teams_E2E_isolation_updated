      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "c3" },
    { "type": "rectangle", "id": "s3", "x": 170, "y": 308, "width": 700, "height": 58,
