    { "type": "text", "id": "c10_t", "x": 102, "y": 883, "width": 26, "height": 20, "text": "10", "fontSize": 17, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "c10" },
    { "type": "rectangle", "id": "s10", "x": 170, "y": 863, "width": 700, "height": 70,
      "strokeColor": "#5C2D91", "backgroundColor": "#E8DAEF", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 } },
    { "type": "text", "id": "s10_t", "x": 188, "y": 875, "width": 670, "height": 46,
      "text": "Deploys the new bot in Azure: the Bot Service that Teams talks to, plus this\nagent's own private translator running inside the network, and a route for it\non the gateway.", "fontSize": 14, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "middle" },

