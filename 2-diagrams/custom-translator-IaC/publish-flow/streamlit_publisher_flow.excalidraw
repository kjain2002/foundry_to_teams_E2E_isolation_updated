    { "type": "text", "id": "s1_t", "x": 188, "y": 170, "width": 670, "height": 38,
      "text": "Sign in with your Microsoft account. The app does this for you \u2014\nyou land straight on the start screen.", "fontSize": 14, "fontFamily": 2,
