    { "type": "text", "id": "c9_t", "x": 105, "y": 813, "width": 20, "height": 20, "text": "9", "fontSize": 18, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "c9" },
    { "type": "rectangle", "id": "s9", "x": 170, "y": 793, "width": 700, "height": 54,
      "strokeColor": "#5C2D91", "backgroundColor": "#E8DAEF", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 } },
    { "type": "text", "id": "s9_t", "x": 188, "y": 803, "width": 670, "height": 34,
      "text": "Builds the translator service image in the cloud (no local Docker needed) and stores it.", "fontSize": 14, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "middle" },

    { "type": "ellipse", "id": "c10", "x": 90, "y": 868, "width": 50, "height": 50,
