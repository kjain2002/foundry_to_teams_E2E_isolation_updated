    { "type": "text", "id": "s4_t", "x": 188, "y": 395, "width": 670, "height": 38,
      "text": "Give the Teams bot a name, short description, and branding \u2014\nthe app suggests sensible defaults from the agent's name.", "fontSize": 14, "fontFamily": 2,
