    { "type": "text", "id": "c8_t", "x": 105, "y": 743, "width": 20, "height": 20, "text": "8", "fontSize": 18, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "c8" },
    { "type": "rectangle", "id": "s8", "x": 170, "y": 723, "width": 700, "height": 54,
      "strokeColor": "#5C2D91", "backgroundColor": "#E8DAEF", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 } },
    { "type": "text", "id": "s8_t", "x": 188, "y": 733, "width": 670, "height": 34,
      "text": "Tells the API gateway to trust this new bot, so its messages are allowed through to Foundry.", "fontSize": 14, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "middle" },

