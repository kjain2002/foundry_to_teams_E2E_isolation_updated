    { "type": "text", "id": "c2_t", "x": 105, "y": 253, "width": 20, "height": 20, "text": "2", "fontSize": 18, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "c2" },
    { "type": "rectangle", "id": "s2", "x": 170, "y": 233, "width": 700, "height": 58,
