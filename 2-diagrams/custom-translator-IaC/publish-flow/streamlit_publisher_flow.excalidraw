    { "type": "text", "id": "c6_t", "x": 105, "y": 598, "width": 20, "height": 20, "text": "6", "fontSize": 18, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "c6" },
    { "type": "rectangle", "id": "s6", "x": 170, "y": 578, "width": 700, "height": 62,
      "strokeColor": "#5C2D91", "backgroundColor": "#E8DAEF", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 } },
    { "type": "text", "id": "s6_t", "x": 188, "y": 590, "width": 670, "height": 38,
      "text": "Creates an identity for the new bot (or reuses it) and generates a fresh\npassword so Teams can prove the bot is really yours.", "fontSize": 14, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "middle" },

    { "type": "ellipse", "id": "c7", "x": 90, "y": 658, "width": 50, "height": 50,
      "strokeColor": "#5C2D91", "backgroundColor": "#E8DAEF", "fillStyle": "solid", "strokeWidth": 2, "boundElements": [{ "type": "text", "id": "c7_t" }] },
    { "type": "text", "id": "c7_t", "x": 105, "y": 673, "width": 20, "height": 20, "text": "7", "fontSize": 18, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "c7" },
    { "type": "rectangle", "id": "s7", "x": 170, "y": 653, "width": 700, "height": 54,
      "strokeColor": "#5C2D91", "backgroundColor": "#E8DAEF", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 } },
    { "type": "text", "id": "s7_t", "x": 188, "y": 663, "width": 670, "height": 34,
      "text": "Saves that password safely in Key Vault, then forgets it \u2014 nothing sensitive stays in the app.", "fontSize": 14, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "middle" },

    { "type": "ellipse", "id": "c8", "x": 90, "y": 728, "width": 50, "height": 50,
