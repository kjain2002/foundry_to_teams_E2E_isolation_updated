{
  "type": "excalidraw",
  "version": 2,
  "source": "copilot",
  "appState": { "viewBackgroundColor": "#ffffff" },
  "elements": [
    { "type": "text", "id": "title", "x": 60, "y": 20, "width": 1200, "height": 40,
      "text": "How ONE shared container serves every agent (no container-per-agent)", "fontSize": 28, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "top" },
    { "type": "text", "id": "subtitle", "x": 60, "y": 66, "width": 1300, "height": 26,
      "text": "The container only transports messages. Agents + their tools run INSIDE Foundry, so a single image works for all of them.", "fontSize": 16, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "top" },

    { "type": "rectangle", "id": "botsgroup", "x": 60, "y": 120, "width": 900, "height": 130,
      "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1,
      "strokeStyle": "dashed", "roundness": { "type": 3 } },
    { "type": "text", "id": "botsgroup_t", "x": 78, "y": 128, "width": 860, "height": 20,
      "text": "N Teams bots \u2014 each agent keeps its OWN Entra app + Azure Bot + Teams manifest", "fontSize": 14, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "top" },

    { "type": "rectangle", "id": "botA", "x": 85, "y": 160, "width": 260, "height": 75,
      "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2,
      "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "botA_t" }] },
    { "type": "text", "id": "botA_t", "x": 95, "y": 180, "width": 240, "height": 36,
      "text": "Agent A (bot A)\nHR assistant", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "botA" },
    { "type": "rectangle", "id": "botB", "x": 380, "y": 160, "width": 260, "height": 75,
      "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2,
      "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "botB_t" }] },
    { "type": "text", "id": "botB_t", "x": 390, "y": 180, "width": 240, "height": 36,
      "text": "Agent B (bot B)\nFinance assistant", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "botB" },
    { "type": "rectangle", "id": "botC", "x": 675, "y": 160, "width": 260, "height": 75,
      "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2,
      "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "botC_t" }] },
    { "type": "text", "id": "botC_t", "x": 685, "y": 180, "width": 240, "height": 36,
      "text": "Agent C (bot C)\nData / Genie assistant", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "botC" },

    { "type": "rectangle", "id": "apim", "x": 300, "y": 320, "width": 420, "height": 80,
      "strokeColor": "#F7630C", "backgroundColor": "#FFF4CE", "fillStyle": "solid", "strokeWidth": 2,
      "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "apim_t" }] },
    { "type": "text", "id": "apim_t", "x": 310, "y": 340, "width": 400, "height": 40,
      "text": "APIM (private)\nvalidate-jwt \u00b7 same backend URL for every bot", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "apim" },

    { "type": "rectangle", "id": "container", "x": 220, "y": 470, "width": 580, "height": 170,
      "strokeColor": "#107C10", "backgroundColor": "#DFF6DD", "fillStyle": "solid", "strokeWidth": 3,
      "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "container_t" }] },
    { "type": "text", "id": "container_t", "x": 240, "y": 490, "width": 540, "height": 130,
      "text": "Shared Container App  \u2014  ONE image\n\nrouter / translator (tool-agnostic)\n1. read bot id from the incoming Activity\n2. look up the row in the registry\n3. call the mapped Foundry agent (as the user)", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "container" },

    { "type": "rectangle", "id": "registry", "x": 880, "y": 445, "width": 460, "height": 220,
      "strokeColor": "#0c8599", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2,
      "roundness": { "type": 3 } },
    { "type": "text", "id": "registry_t", "x": 898, "y": 455, "width": 420, "height": 20,
      "text": "Registry (Azure Table) \u2014 one ROW per agent", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "top" },
    { "type": "rectangle", "id": "regrows", "x": 900, "y": 485, "width": 420, "height": 160,
      "strokeColor": "#0c8599", "backgroundColor": "#99e9f2", "fillStyle": "solid", "strokeWidth": 2,
      "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "regrows_t" }] },
    { "type": "text", "id": "regrows_t", "x": 916, "y": 500, "width": 388, "height": 130,
      "text": "botId    agentName    authMode\n---------------------------------\nbotA     agent-a         app\nbotB     agent-b         app\nbotC     agent-c         oauth", "fontSize": 15, "fontFamily": 3, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "middle", "containerId": "regrows" },

    { "type": "rectangle", "id": "foundry", "x": 300, "y": 720, "width": 700, "height": 180,
      "strokeColor": "#5C2D91", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3,
      "roundness": { "type": 3 } },
    { "type": "text", "id": "foundry_t", "x": 318, "y": 730, "width": 660, "height": 24,
      "text": "Azure AI Foundry (private) \u2014 every agent runtime + its tools live HERE", "fontSize": 15, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "top" },
    { "type": "rectangle", "id": "fa", "x": 325, "y": 775, "width": 200, "height": 100,
      "strokeColor": "#5C2D91", "backgroundColor": "#E8DAEF", "fillStyle": "solid", "strokeWidth": 2,
      "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "fa_t" }] },
    { "type": "text", "id": "fa_t", "x": 335, "y": 800, "width": 180, "height": 50,
      "text": "agent-a\n+ its tools\n(MCP)", "fontSize": 13, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "fa" },
    { "type": "rectangle", "id": "fb", "x": 550, "y": 775, "width": 200, "height": 100,
      "strokeColor": "#5C2D91", "backgroundColor": "#E8DAEF", "fillStyle": "solid", "strokeWidth": 2,
      "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "fb_t" }] },
    { "type": "text", "id": "fb_t", "x": 560, "y": 800, "width": 180, "height": 50,
      "text": "agent-b\n+ its tools\n(MCP)", "fontSize": 13, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "fb" },
    { "type": "rectangle", "id": "fc", "x": 775, "y": 775, "width": 200, "height": 100,
      "strokeColor": "#5C2D91", "backgroundColor": "#E8DAEF", "fillStyle": "solid", "strokeWidth": 2,
      "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "fc_t" }] },
    { "type": "text", "id": "fc_t", "x": 785, "y": 800, "width": 180, "height": 50,
      "text": "agent-c\n+ Genie tool\n(MCP)", "fontSize": 13, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "fc" },

    { "type": "rectangle", "id": "publish", "x": 1030, "y": 160, "width": 300, "height": 100,
      "strokeColor": "#107C10", "backgroundColor": "#DFF6DD", "fillStyle": "solid", "strokeWidth": 2,
      "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "publish_t" }] },
    { "type": "text", "id": "publish_t", "x": 1040, "y": 185, "width": 280, "height": 50,
      "text": "Publish (Streamlit / notebook)\nadds an agent = write ONE row\n+ hand back a Teams .zip", "fontSize": 13, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "publish" },

    { "type": "arrow", "id": "a_botA_apim", "x": 215, "y": 235, "width": 300, "height": 82,
      "strokeColor": "#1e1e1e", "strokeWidth": 2, "points": [[0, 0], [300, 82]],
      "startBinding": { "elementId": "botA", "focus": 0, "gap": 2 },
      "endBinding": { "elementId": "apim", "focus": 0, "gap": 2 } },
    { "type": "arrow", "id": "a_botB_apim", "x": 510, "y": 235, "width": 0, "height": 82,
      "strokeColor": "#1e1e1e", "strokeWidth": 2, "points": [[0, 0], [0, 82]],
      "startBinding": { "elementId": "botB", "focus": 0, "gap": 2 },
      "endBinding": { "elementId": "apim", "focus": 0, "gap": 2 } },
    { "type": "arrow", "id": "a_botC_apim", "x": 805, "y": 235, "width": -300, "height": 82,
      "strokeColor": "#1e1e1e", "strokeWidth": 2, "points": [[0, 0], [-300, 82]],
      "startBinding": { "elementId": "botC", "focus": 0, "gap": 2 },
      "endBinding": { "elementId": "apim", "focus": 0, "gap": 2 } },

    { "type": "arrow", "id": "a_apim_container", "x": 510, "y": 400, "width": 0, "height": 68,
      "strokeColor": "#1e1e1e", "strokeWidth": 2, "points": [[0, 0], [0, 68]],
      "startBinding": { "elementId": "apim", "focus": 0, "gap": 2 },
      "endBinding": { "elementId": "container", "focus": 0, "gap": 2 } },

    { "type": "arrow", "id": "a_container_registry", "x": 800, "y": 555, "width": 78, "height": 0,
      "strokeColor": "#0c8599", "strokeWidth": 2, "strokeStyle": "dashed", "points": [[0, 0], [78, 0]],
      "startBinding": { "elementId": "container", "focus": 0, "gap": 2 },
      "endBinding": { "elementId": "regrows", "focus": 0, "gap": 2 } },
    { "type": "text", "id": "l_container_registry", "x": 790, "y": 520, "width": 110, "height": 32,
      "text": "reads route\n+ authMode", "fontSize": 12, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "top" },

    { "type": "arrow", "id": "a_container_foundry", "x": 510, "y": 640, "width": 0, "height": 78,
      "strokeColor": "#1e1e1e", "strokeWidth": 2, "points": [[0, 0], [0, 78]],
      "startBinding": { "elementId": "container", "focus": 0, "gap": 2 },
      "endBinding": { "elementId": "foundry", "focus": 0, "gap": 2 } },
    { "type": "text", "id": "l_container_foundry", "x": 520, "y": 670, "width": 260, "height": 20,
      "text": "one agent SDK call \u2014 runs as the signed-in user", "fontSize": 12, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "top" },

    { "type": "arrow", "id": "a_publish_registry", "x": 1160, "y": 260, "width": 0, "height": 220,
      "strokeColor": "#107C10", "strokeWidth": 2, "strokeStyle": "dashed", "points": [[0, 0], [0, 220]],
      "startBinding": { "elementId": "publish", "focus": 0, "gap": 2 },
      "endBinding": { "elementId": "regrows", "focus": 0, "gap": 2 } },

    { "type": "rectangle", "id": "why", "x": 1030, "y": 470, "width": 420, "height": 170,
      "strokeColor": "#107C10", "backgroundColor": "#DFF6DD", "fillStyle": "solid", "strokeWidth": 2,
      "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "why_t" }] },
    { "type": "text", "id": "why_t", "x": 1046, "y": 485, "width": 388, "height": 140,
      "text": "Why no container per agent?\n\n\u2022 The container has NO agent-specific code \u2014\n  it just moves Bot Protocol \u2194 Foundry.\n\u2022 Tools (Genie, search\u2026) execute in Foundry,\n  not in the container.\n\u2022 So a new agent needs a new ROW, not a new\n  image, deploy, or scale unit.", "fontSize": 13, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "middle", "containerId": "why" },

    { "type": "rectangle", "id": "before", "x": 60, "y": 950, "width": 640, "height": 90,
      "strokeColor": "#D13438", "backgroundColor": "#FDE7E9", "fillStyle": "solid", "strokeWidth": 2,
      "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "before_t" }] },
    { "type": "text", "id": "before_t", "x": 76, "y": 965, "width": 608, "height": 60,
      "text": "BEFORE (per-agent Function App):\nN agents \u2192 N compute apps to deploy, secure, patch and scale.", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "before" },
    { "type": "rectangle", "id": "after", "x": 730, "y": 950, "width": 640, "height": 90,
      "strokeColor": "#107C10", "backgroundColor": "#DFF6DD", "fillStyle": "solid", "strokeWidth": 2,
      "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "after_t" }] },
    { "type": "text", "id": "after_t", "x": 746, "y": 965, "width": 608, "height": 60,
      "text": "NOW (shared container):\nN agents \u2192 1 image to patch + N table rows. Add an agent = a Publish click.", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "after" }
  ]
}
