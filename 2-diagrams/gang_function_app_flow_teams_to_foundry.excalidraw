{
  "type": "excalidraw",
  "version": 2,
  "source": "copilot",
  "appState": { "viewBackgroundColor": "#ffffff" },
  "elements": [
    { "type": "text", "id": "title", "x": 40, "y": 20, "width": 1300, "height": 40,
      "text": "Teams \u2192 Private Foundry: Gang's Function App Flow (June 25 working session)", "fontSize": 28, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "top" },
    { "type": "text", "id": "subtitle", "x": 40, "y": 64, "width": 1300, "height": 24,
      "text": "Experimental request path: a PUBLIC Function App is the first entry point in front of the Bot Service, then APIM, then the private Foundry agent.", "fontSize": 14, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "top" },

    { "type": "rectangle", "id": "insight", "x": 40, "y": 100, "width": 1620, "height": 70,
      "strokeColor": "#D13438", "backgroundColor": "#FDE7E9", "fillStyle": "solid", "strokeWidth": 2,
      "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "insight_t" }] },
    { "type": "text", "id": "insight_t", "x": 60, "y": 110, "width": 1580, "height": 50,
      "text": "KEY CONSTRAINT: End-to-end private isolation is NOT achievable. Teams, the Azure Bot Service, and the Function App must stay PUBLIC.\nOnly Foundry and downstream data (Databricks) are private. The auto-created managed identity cannot be used for token exchange.", "fontSize": 14, "fontFamily": 2,
      "strokeColor": "#000000", "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "insight" },

    { "type": "rectangle", "id": "pubzone", "x": 40, "y": 210, "width": 1000, "height": 400,
      "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2,
      "strokeStyle": "dashed", "roundness": { "type": 3 } },
    { "type": "text", "id": "pubzone_t", "x": 60, "y": 220, "width": 600, "height": 22,
      "text": "PUBLIC \u2014 Microsoft backbone / multi-tenant (must stay public)", "fontSize": 16, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "top" },

    { "type": "rectangle", "id": "privzone", "x": 1080, "y": 210, "width": 580, "height": 400,
      "strokeColor": "#5C2D91", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3,
      "roundness": { "type": 3 } },
    { "type": "text", "id": "privzone_t", "x": 1100, "y": 220, "width": 540, "height": 22,
      "text": "PRIVATE \u2014 BYO VNet (privateNetworkAccess)", "fontSize": 16, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "top" },

    { "type": "rectangle", "id": "teamsuser", "x": 70, "y": 300, "width": 175, "height": 80,
      "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2,
      "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "teamsuser_t" }] },
    { "type": "text", "id": "teamsuser_t", "x": 80, "y": 325, "width": 155, "height": 32,
      "text": "Teams user\n(Teams client)", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "teamsuser" },

    { "type": "rectangle", "id": "channel", "x": 295, "y": 300, "width": 200, "height": 80,
      "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2,
      "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "channel_t" }] },
    { "type": "text", "id": "channel_t", "x": 305, "y": 325, "width": 180, "height": 32,
      "text": "Bot Framework\nChannel Service", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "channel" },

    { "type": "rectangle", "id": "botsvc", "x": 545, "y": 300, "width": 215, "height": 80,
      "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2,
      "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "botsvc_t" }] },
    { "type": "text", "id": "botsvc_t", "x": 555, "y": 320, "width": 195, "height": 44,
      "text": "Azure Bot Service\n(multi-tenant, public)\n+ Teams channel", "fontSize": 13, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "botsvc" },

    { "type": "rectangle", "id": "funcapp", "x": 810, "y": 290, "width": 210, "height": 100,
      "strokeColor": "#F7630C", "backgroundColor": "#FFF4CE", "fillStyle": "solid", "strokeWidth": 3,
      "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "funcapp_t" }] },
    { "type": "text", "id": "funcapp_t", "x": 820, "y": 305, "width": 190, "height": 70,
      "text": "Function App\n(FIRST entry point)\nMUST stay PUBLIC\ninteracts with Bot Service", "fontSize": 13, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "funcapp" },

    { "type": "rectangle", "id": "oauthnote", "x": 295, "y": 440, "width": 465, "height": 130,
      "strokeColor": "#1e1e1e", "backgroundColor": "#F3F2F1", "fillStyle": "solid", "strokeWidth": 1,
      "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "oauthnote_t" }] },
    { "type": "text", "id": "oauthnote_t", "x": 310, "y": 450, "width": 435, "height": 110,
      "text": "Authentication (new):\n\u2022 New App Registration (OAuth)\n\u2022 Brand-new Bot Service with OAuth\n\u2022 Auto-created Managed Identity CANNOT be used\n   to exchange tokens \u2192 OBO instead", "fontSize": 13, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "middle", "containerId": "oauthnote" },

    { "type": "rectangle", "id": "apim", "x": 1100, "y": 300, "width": 230, "height": 80,
      "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2,
      "strokeStyle": "dashed", "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "apim_t" }] },
    { "type": "text", "id": "apim_t", "x": 1110, "y": 320, "width": 210, "height": 40,
      "text": "APIM (\"Edpain\")\nin the middle", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "apim" },
    { "type": "text", "id": "apim_note", "x": 1100, "y": 388, "width": 230, "height": 36,
      "text": "Gang: candidate to remove\n(little value in this flow)", "fontSize": 12, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "top" },

    { "type": "rectangle", "id": "foundry", "x": 1400, "y": 300, "width": 240, "height": 80,
      "strokeColor": "#5C2D91", "backgroundColor": "#E8DAEF", "fillStyle": "solid", "strokeWidth": 2,
      "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "foundry_t" }] },
    { "type": "text", "id": "foundry_t", "x": 1410, "y": 320, "width": 220, "height": 44,
      "text": "Foundry agent\n(privately configured)\ncalled directly via API", "fontSize": 13, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "foundry" },

    { "type": "rectangle", "id": "databricks", "x": 1180, "y": 450, "width": 390, "height": 110,
      "strokeColor": "#0c8599", "backgroundColor": "#99e9f2", "fillStyle": "solid", "strokeWidth": 2,
      "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "databricks_t" }] },
    { "type": "text", "id": "databricks_t", "x": 1190, "y": 470, "width": 370, "height": 70,
      "text": "Databricks (MCP Genie / data)\nReached via OBO (on-behalf-of):\nuser's regular account token \u2192 access\nassigned in Databricks", "fontSize": 13, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "databricks" },

    { "type": "line", "id": "boundary", "x": 1060, "y": 215, "width": 0, "height": 390,
      "strokeColor": "#D13438", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2,
      "strokeStyle": "dashed", "points": [[0, 0], [0, 390]] },
    { "type": "text", "id": "boundary_t", "x": 1000, "y": 180, "width": 200, "height": 22,
      "text": "public \u27f6 private boundary", "fontSize": 13, "fontFamily": 2, "strokeColor": "#D13438",
      "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "top" },

    { "type": "rectangle", "id": "variant", "x": 40, "y": 630, "width": 1000, "height": 95,
      "strokeColor": "#107C10", "backgroundColor": "#DFF6DD", "fillStyle": "solid", "strokeWidth": 2,
      "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "variant_t" }] },
    { "type": "text", "id": "variant_t", "x": 55, "y": 645, "width": 970, "height": 65,
      "text": "Khushi's variant: a per-agent Container App (protocol translator) replaces the Function App.\nIt translates the Bot Service \u2194 Foundry activity protocol so MCP authentication works reliably. Same constraint: the public ingress (Bot Service) still cannot be made private.", "fontSize": 13, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "middle", "containerId": "variant" },

    { "type": "arrow", "id": "a1", "x": 245, "y": 340, "width": 50, "height": 0,
      "strokeColor": "#1e1e1e", "strokeWidth": 2, "roundness": { "type": 2 }, "points": [[0, 0], [50, 0]],
      "startBinding": { "elementId": "teamsuser", "focus": 0, "gap": 2 },
      "endBinding": { "elementId": "channel", "focus": 0, "gap": 2 } },
    { "type": "arrow", "id": "a2", "x": 495, "y": 340, "width": 50, "height": 0,
      "strokeColor": "#1e1e1e", "strokeWidth": 2, "roundness": { "type": 2 }, "points": [[0, 0], [50, 0]],
      "startBinding": { "elementId": "channel", "focus": 0, "gap": 2 },
      "endBinding": { "elementId": "botsvc", "focus": 0, "gap": 2 } },
    { "type": "arrow", "id": "a3", "x": 760, "y": 340, "width": 50, "height": 0,
      "strokeColor": "#1e1e1e", "strokeWidth": 2, "roundness": { "type": 2 }, "points": [[0, 0], [50, 0]],
      "startBinding": { "elementId": "botsvc", "focus": 0, "gap": 2 },
      "endBinding": { "elementId": "funcapp", "focus": 0, "gap": 2 } },
    { "type": "arrow", "id": "a4", "x": 1020, "y": 340, "width": 80, "height": 0,
      "strokeColor": "#D13438", "strokeWidth": 2, "roundness": { "type": 2 }, "points": [[0, 0], [80, 0]],
      "startBinding": { "elementId": "funcapp", "focus": 0, "gap": 2 },
      "endBinding": { "elementId": "apim", "focus": 0, "gap": 2 } },
    { "type": "arrow", "id": "a5", "x": 1330, "y": 340, "width": 70, "height": 0,
      "strokeColor": "#1e1e1e", "strokeWidth": 2, "roundness": { "type": 2 }, "points": [[0, 0], [70, 0]],
      "startBinding": { "elementId": "apim", "focus": 0, "gap": 2 },
      "endBinding": { "elementId": "foundry", "focus": 0, "gap": 2 } },
    { "type": "arrow", "id": "a6", "x": 1520, "y": 382, "width": 130, "height": 66,
      "strokeColor": "#0c8599", "strokeWidth": 2, "roundness": { "type": 2 }, "points": [[0, 0], [-130, 66]],
      "startBinding": { "elementId": "foundry", "focus": 0, "gap": 2 },
      "endBinding": { "elementId": "databricks", "focus": 0, "gap": 2 } },
    { "type": "text", "id": "a6_t", "x": 1410, "y": 408, "width": 180, "height": 20,
      "text": "OBO token \u2192 data", "fontSize": 12, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "top" }
  ]
