    {
      "type": "text",
      "id": "subtitle",
      "x": 40,
      "y": 74,
      "width": 1500,
      "height": 26,
      "text": "One request flows left to right. The two boundaries are just two DIFFERENT auth jobs happening at two DIFFERENT places along that flow.",
      "fontSize": 15,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "textAlign": "left",
      "verticalAlign": "top",
      "version": 2,
