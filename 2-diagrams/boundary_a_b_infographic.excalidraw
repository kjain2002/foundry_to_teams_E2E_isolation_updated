    {
      "type": "text",
      "id": "twoCT",
      "x": 60,
      "y": 782,
      "width": 1460,
      "height": 80,
      "text": "TWO CONSENTS — don't conflate:\n(1) Foundry sign-in / connection card — the user ALWAYS taps this (proves identity + confirms the connection). Pre-auth does NOT remove it.\n(2) Entra permission-grant form (\"app X wants to do Y & Z — agree?\") — THIS is what pre-authorization (or admin consent) removes: no user prompt, no admin needed.",
      "fontSize": 14,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "twoC",
      "version": 2,
      "versionNonce": 198225035,
      "index": "aZ",
      "isDeleted": false,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "seed": 1,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1784554207570,
      "link": null,
      "locked": false,
      "originalText": "TWO CONSENTS — don't conflate:\n(1) Foundry sign-in / connection card — the user ALWAYS taps this (proves identity + confirms the connection). Pre-auth does NOT remove it.\n(2) Entra permission-grant form (\"app X wants to do Y & Z — agree?\") — THIS is what pre-authorization (or admin consent) removes: no user prompt, no admin needed.",
      "autoResize": true,
      "lineHeight": 1.9047619047619049
    }
