    { "type": "text", "id": "pedata_t", "x": 1115, "y": 425, "width": 185, "height": 36,
      "text": "PE \u2192 Search / Storage\n/ Cosmos", "fontSize": 12, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "pedata" },

    { "type": "rectangle", "id": "agentsub", "x": 1370, "y": 290, "width": 260, "height": 200,
