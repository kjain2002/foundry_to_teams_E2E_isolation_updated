    { "type": "rectangle", "id": "variant", "x": 40, "y": 660, "width": 980, "height": 100,
      "strokeColor": "#107C10", "backgroundColor": "#DFF6DD", "fillStyle": "solid", "strokeWidth": 2,
      "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "variant_t" }] },
    { "type": "text", "id": "variant_t", "x": 55, "y": 675, "width": 950, "height": 70,
      "text": "Khushi's variant: a per-agent Container App (protocol translator) replaces the Function App.\nIt translates the Bot Service \u2194 Foundry activity protocol so MCP authentication works reliably. Same constraint applies: the public ingress (Bot Service) still cannot be made private. Neither path requires APIM.", "fontSize": 13, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "middle", "containerId": "variant" },

    { "type": "arrow", "id": "a1", "x": 245, "y": 340, "width": 50, "height": 0,
