    { "type": "text", "id": "a4_t", "x": 1000, "y": 300, "width": 110, "height": 20,
      "text": "direct (no APIM)", "fontSize": 12, "fontFamily": 2, "strokeColor": "#107C10",
      "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "top" },
    { "type": "arrow", "id": "a5", "x": 1310, "y": 370, "width": 80, "height": 25,
