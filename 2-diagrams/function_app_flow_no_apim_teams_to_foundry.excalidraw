    { "type": "text", "id": "botsvc_t", "x": 550, "y": 320, "width": 190, "height": 44,
      "text": "Azure Bot Service\n(multi-tenant, public)\n+ Teams channel", "fontSize": 13, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "botsvc" },

    { "type": "rectangle", "id": "funcapp", "x": 795, "y": 290, "width": 200, "height": 100,
      "strokeColor": "#F7630C", "backgroundColor": "#FFF4CE", "fillStyle": "solid", "strokeWidth": 3,
      "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "funcapp_t" }] },
    { "type": "text", "id": "funcapp_t", "x": 805, "y": 303, "width": 180, "height": 74,
      "text": "Function App\n(FIRST entry point)\nMUST stay PUBLIC\nVNet-integrated\n(outbound to PE)", "fontSize": 13, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "center", "verticalAlign": "middle", "containerId": "funcapp" },

    { "type": "rectangle", "id": "oauthnote", "x": 295, "y": 450, "width": 455, "height": 140,
      "strokeColor": "#1e1e1e", "backgroundColor": "#F3F2F1", "fillStyle": "solid", "strokeWidth": 1,
      "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "oauthnote_t" }] },
    { "type": "text", "id": "oauthnote_t", "x": 310, "y": 460, "width": 425, "height": 120,
      "text": "Authentication (new):\n\u2022 New App Registration (OAuth)\n\u2022 Brand-new Bot Service with OAuth\n\u2022 Auto-created Managed Identity CANNOT\n   exchange tokens \u2192 OBO instead\n\u2022 No APIM = no validate-jwt hop", "fontSize": 13, "fontFamily": 2, "strokeColor": "#000000",
      "backgroundColor": "transparent", "textAlign": "left", "verticalAlign": "middle", "containerId": "oauthnote" },

    { "type": "rectangle", "id": "pesub", "x": 1085, "y": 290, "width": 245, "height": 200,
